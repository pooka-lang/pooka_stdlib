//// Borrow a name from the environment, then put it back.
////
//// An unset variable differs from a present variable containing an empty string.
//// The mutating test saves its previous value and restores it on the passing path.
//// Other checks accept host-specific directory and platform values without
//// promising the same machine will always be sitting at the desk.
////
//// ```pooka
//// assert env.get("") != Ok(None)
//// ```

module env_test

import pooka/env
import pooka/list
import pooka/string

// Save the old value before borrowing this environment name. None and an
// empty String are checked separately, then the passing test restores the old state.
test "environment distinguishes unset and empty values" {
  let name = "POOKA_STDLIB_ASSERTION_VALUE"
  let assert Ok(previous) = env.get(name)
  assert env.unset(name) == Ok(Nil)
  assert env.get(name) == Ok(None)
  assert env.set(name, "") == Ok(Nil)
  assert env.get(name) == Ok(Some(""))
  assert env.set(name, "α🐇") == Ok(Nil)
  assert env.get(name) == Ok(Some("α🐇"))
  match previous {
    Some(value) -> {
      assert env.set(name, value) == Ok(Nil)
    }
    None -> {
      assert env.unset(name) == Ok(Nil)
    }
  }
}

// Names and values must survive the host environment interface. Empty names,
// equals signs in names and a NUL inside a value are rejected as EnvError.
test "invalid environment names return errors" {
  let assert Error(env.EnvError(_)) = env.get("")
  let assert Error(env.EnvError(_)) = env.set("A=B", "x")
  let assert Error(env.EnvError(_)) = env.unset("A=B")
  let assert Error(env.EnvError(_)) = env.set("A", "\u{0}")
}

// Directory results may depend on the host, especially whether a home
// directory is available. Match that possibility without inventing a default path.
test "working and home directories are typed" {
  let assert Ok(cwd) = env.current_directory()
  assert !string.is_empty(cwd)
  let assert Ok(home) = env.home_directory()
  match home {
    Some(value) -> {
      assert !string.is_empty(value)
    }
    None -> Nil
  }
  assert list.all(env.args(), fn(arg) { string.length(arg) >= 0 })
}

// The host supplies these names, so exact spellings would tie the suite to
// one machine. Here we only require a nonempty report from each query.
test "host platform names are reported" {
  assert !string.is_empty(env.os())
  assert !string.is_empty(env.architecture())
}
