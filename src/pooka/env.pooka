//// The process arrives with a little weather from its surroundings.
////
//// Read arguments, environment variables and platform information through Erlang.
//// Missing variables use Option, while operating-system failures use EnvError.
//// Arguments exclude the Pooka executable entrypoint.
////
//// ```pooka
//// import pooka/env
////
//// let assert Ok(value) = env.get("POOKA_EXAMPLE")
//// ```

module env

/// A env failure carrying the details needed by its caller. Keep this value in
/// Result until a boundary can explain it.
class EnvError(message: String)

external _Environment from erlang "pooka_stdlib_ffi" {
  env_args() -> List(String)

  env_get(name: String) -> Result(Option(String), String)

  env_set(name: String, value: String) -> Result(Nil, String)

  env_unset(name: String) -> Result(Nil, String)

  env_cwd() -> Result(String, String)

  env_home() -> Result(Option(String), String)

  env_os() -> String

  env_architecture() -> String
}

/// Translate the foreign error payload into this module's error type while
/// leaving a successful value unchanged.
_error(value: Result(a, String)) -> Result(a, EnvError) {
  match value {
    Ok(x) -> Ok(x)
    Error(e) -> Error(EnvError(e))
  }
}

/// Return program arguments without the executable entrypoint path.
///
/// ```pooka
/// import pooka/env
///
/// let arguments = env.args()
/// ```
args() -> List(String) {
  _Environment.env_args()
}

/// Read a variable. An absent name returns Ok(None).
///
/// ```pooka
/// import pooka/env
///
/// let assert Ok(value) = env.get("POOKA_EXAMPLE")
/// ```
get(name: String) -> Result(Option(String), EnvError) {
  _error(_Environment.env_get(name))
}

/// Set a variable in this process environment.
///
/// ```pooka
/// import pooka/env
///
/// let result = env.set("POOKA_EXAMPLE", "oak")
/// ```
set(name: String, value: String) -> Result(Nil, EnvError) {
  _error(_Environment.env_set(name, value))
}

/// Remove a variable from this process environment.
///
/// ```pooka
/// import pooka/env
///
/// let result = env.unset("POOKA_EXAMPLE")
/// ```
unset(name: String) -> Result(Nil, EnvError) {
  _error(_Environment.env_unset(name))
}

/// Read the current working directory, retaining operating-system failure as
/// EnvError.
///
/// ```pooka
/// import pooka/env
///
/// let result = env.current_directory()
/// ```
current_directory() -> Result(String, EnvError) {
  _error(_Environment.env_cwd())
}

/// Read the home directory when available.
///
/// ```pooka
/// import pooka/env
///
/// let result = env.home_directory()
/// ```
home_directory() -> Result(Option(String), EnvError) {
  _error(_Environment.env_home())
}

/// Return the Erlang runtime's operating-system name.
///
/// ```pooka
/// import pooka/env
///
/// let system = env.os()
/// ```
os() -> String {
  _Environment.env_os()
}

/// Return the runtime system architecture string.
///
/// ```pooka
/// import pooka/env
///
/// let architecture = env.architecture()
/// ```
architecture() -> String {
  _Environment.env_architecture()
}
