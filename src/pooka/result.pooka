//// Carry the answer and the explanation in different envelopes.
////
//// Transform successful values or errors without throwing away the other branch.
//// flat_map chains a fallible callback, while conversion to Option deliberately
//// discards error details.
////
//// ```pooka
//// import pooka/result
////
//// assert result.map(Ok(2), fn(x) { x + 1 }) == Ok(3)
//// ```

module result

import pooka/list

/// Transform the carried value; an absent or failed branch passes through
/// unchanged.
///
/// ```pooka
/// import pooka/result
///
/// assert result.map(Ok(2), fn(x) { x + 1 }) == Ok(3)
/// ```
map(value: Result(a, e), transform: fn(a) -> b) -> Result(b, e) {
  match value {
    Ok(x) -> Ok(transform(x))
    Error(e) -> Error(e)
  }
}

/// Transform only the error, preserving successful values.
///
/// ```pooka
/// import pooka/result
///
/// assert result.map_error(Error(2), fn(x) { x + 1 }) == Error(3)
/// ```
map_error(value: Result(a, e), transform: fn(e) -> f) -> Result(a, f) {
  match value {
    Ok(x) -> Ok(x)
    Error(e) -> Error(transform(e))
  }
}

/// Chain a callback that already returns the same fallible wrapper.
///
/// ```pooka
/// import pooka/result
///
/// assert result.flat_map(Ok(2), fn(x) { Ok(x + 1) }) == Ok(3)
/// ```
flat_map(value: Result(a, e), transform: fn(a) -> Result(b, e)) -> Result(b, e) {
  match value {
    Ok(x) -> transform(x)
    Error(e) -> Error(e)
  }
}

/// Return the carried value, or the already evaluated fallback.
///
/// ```pooka
/// import pooka/result
///
/// assert result.unwrap_or(Error("missing"), 7) == 7
/// ```
unwrap_or(value: Result(a, e), default: a) -> a {
  match value {
    Ok(x) -> x
    Error(_) -> default
  }
}

/// Call the fallback with the error only when the Result failed.
///
/// ```pooka
/// import pooka/result
///
/// assert result.unwrap_or_else(Error(2), fn(error) { error + 1 }) == 3
/// ```
unwrap_or_else(value: Result(a, e), fallback: fn(e) -> a) -> a {
  match value {
    Ok(x) -> x
    Error(e) -> fallback(e)
  }
}

/// Ask whether the Result carries success.
///
/// ```pooka
/// import pooka/result
///
/// assert result.is_ok(Ok(1))
/// ```
is_ok(value: Result(a, e)) -> Bool {
  match value {
    Ok(_) -> True
    Error(_) -> False
  }
}

/// Ask whether the Result carries an error.
///
/// ```pooka
/// import pooka/result
///
/// assert result.is_error(Error("missing"))
/// ```
is_error(value: Result(a, e)) -> Bool {
  !is_ok(value)
}

/// Keep a successful value and deliberately discard error details.
///
/// ```pooka
/// import pooka/result
///
/// assert result.to_option(Ok(1)) == Some(1)
/// ```
to_option(value: Result(a, e)) -> Option(a) {
  match value {
    Ok(x) -> Some(x)
    Error(_) -> None
  }
}

/// Open every successful envelope, stopping at the first error.
///
/// ```pooka
/// assert result.all([Ok(1), Ok(2)]) == Ok([1, 2])
/// ```
all(values: List(Result(a, e))) -> Result(List(a), e) {
  _all(values, [])
}

_all(values, acc) {
  match values {
    [] -> Ok(list.reverse(acc))
    [Ok(value), ..rest] -> _all(rest, list.prepend(acc, value))
    [Error(error), .._rest] -> Error(error)
  }
}

/// Remove one layer of wrapping; either error keeps its explanation.
///
/// ```pooka
/// assert result.flatten(Ok(Ok(1))) == Ok(1)
/// ```
flatten(value: Result(Result(a, e), e)) -> Result(a, e) {
  flat_map(value, fn(inner) { inner })
}

/// Ask the fallback only after failure. It may change the error type.
///
/// ```pooka
/// assert result.recover(Error("missing"), fn(_) { Ok(1) }) == Ok(1)
/// ```
recover(value: Result(a, e), fallback: fn(e) -> Result(a, f)) -> Result(a, f) {
  match value {
    Ok(found) -> Ok(found)
    Error(error) -> fallback(error)
  }
}

/// Separate successes and errors, preserving their input order.
///
/// ```pooka
/// assert result.partition([Ok(1), Error("no")]) == #([1], ["no"])
/// ```
partition(values: List(Result(a, e))) -> #(List(a), List(e)) {
  let #(yes, no) = list.fold(values, #([], []), fn(acc, value) {
    let #(yes, no) = acc
    match value {
      Ok(found) -> #(list.prepend(yes, found), no)
      Error(error) -> #(yes, list.prepend(no, error))
    }
  })
  #(list.reverse(yes), list.reverse(no))
}

/// Keep successful values in order, deliberately leaving errors behind.
///
/// ```pooka
/// assert result.values([Ok(1), Error("no"), Ok(2)]) == [1, 2]
/// ```
values(items: List(Result(a, e))) -> List(a) {
  list.filter_map(items, to_option)
}
