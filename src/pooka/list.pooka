//// A list is a patient little queue; its old versions keep their places.
////
//// Build and transform immutable singly linked lists. Functions take the list
//// first so a chain of transformations can travel through pipes. Indexes start at
//// zero; ranges exclude their upper bound. Sorting is stable, and callbacks run
//// in list order.
////
//// ```pooka
//// import pooka/list
////
//// assert ([1, 2, 3] |> list.map(fn(x) { x * 2 })) == [2, 4, 6]
//// ```

module list

import pooka/order.{Order}

external _Primitives from erlang "pooka_stdlib_ffi" {
  cons(values: List(a), value: a) -> List(a)

  quotient(a: Int, b: Int) -> Int
}

// These calls walk the list inside OTP, without a Pooka closure at every cell.
// reverse/2 also lets a merge attach its untouched tail in the same pass.
// https://www.erlang.org/doc/apps/stdlib/lists.html#reverse/2
external _Lists from erlang "lists" {
  reverse(values: List(a)) -> List(a)

  append(left: List(a), right: List(a)) -> List(a)

  sort(values: List(a)) -> List(a)
}

external _ListTail from erlang "lists" {
  reverse(values: List(a), tail: List(a)) -> List(a)
}

external _Erlang from erlang "erlang" {
  length(values: List(a)) -> Int
}

/// Return an empty list, ready to welcome elements of one inferred type.
///
/// ```pooka
/// import pooka/list
///
/// assert list.empty() == []
/// ```
empty() -> List(a) {
  []
}

/// Ask whether the list has no elements.
///
/// ```pooka
/// import pooka/list
///
/// assert list.is_empty([])
/// ```
is_empty(values: List(a)) -> Bool {
  match values {
    [] -> True
    _ -> False
  }
}

/// Count elements from left to right; this walks the list.
///
/// ```pooka
/// import pooka/list
///
/// assert list.length([1, 2, 3]) == 3
/// ```
length(values: List(a)) -> Int {
  _Erlang.length(values)
}

/// Open the first envelope, or return None for an empty list.
///
/// ```pooka
/// import pooka/list
///
/// assert list.first([4, 5]) == Some(4)
/// ```
first(values: List(a)) -> Option(a) {
  match values {
    [] -> None
    [x, .._rest] -> Some(x)
  }
}

/// Walk to the final element, or return None when there is none.
///
/// ```pooka
/// import pooka/list
///
/// assert list.last([4, 5]) == Some(5)
/// ```
last(values: List(a)) -> Option(a) {
  match values {
    [] -> None
    [x] -> Some(x)
    [_, ..rest] -> last(rest)
  }
}

/// Read a zero-based index. Negative and out-of-range indexes return None.
///
/// ```pooka
/// import pooka/list
///
/// assert list.at([4, 5], 1) == Some(5)
/// ```
at(values: List(a), index: Int) -> Option(a) {
  match index < 0 {
    True -> None
    False -> match values {
      [] -> None
      [x, ..rest] -> match index {
        0 -> Some(x)
        _ -> at(rest, index - 1)
      }
    }
  }
}

/// Put a value at the front without walking the existing list.
///
/// ```pooka
/// import pooka/list
///
/// assert list.prepend([2, 3], 1) == [1, 2, 3]
/// ```
prepend(values: List(a), value: a) -> List(a) {
  _Primitives.cons(values, value)
}

/// Put a value at the end, rebuilding the path through the original list.
///
/// ```pooka
/// import pooka/list
///
/// assert list.append([1, 2], 3) == [1, 2, 3]
/// ```
append(values: List(a), value: a) -> List(a) {
  concat(values, [value])
}

/// Join two lists while retaining their element order.
///
/// ```pooka
/// import pooka/list
///
/// assert list.concat([1, 2], [3]) == [1, 2, 3]
/// ```
concat(left: List(a), right: List(a)) -> List(a) {
  _Lists.append(left, right)
}

/// Turn the list around in one pass through OTP, without an element callback.
///
/// ```pooka
/// import pooka/list
///
/// assert list.reverse([1, 2, 3]) == [3, 2, 1]
/// ```
reverse(values: List(a)) -> List(a) {
  _Lists.reverse(values)
}

/// Visit each element once and keep the callback results in their original
/// order.
///
/// ```pooka
/// import pooka/list
///
/// assert list.map([1, 2], fn(x) { x * 2 }) == [2, 4]
/// ```
map(values: List(a), transform: fn(a) -> b) -> List(b) {
  values
  |> fold([], fn(acc, x) { prepend(acc, transform(x)) })
  |> reverse()
}

/// Keep the elements whose predicate returns True, preserving their order.
///
/// ```pooka
/// import pooka/list
///
/// assert list.filter([1, 2, 3], fn(x) { x > 1 }) == [2, 3]
/// ```
filter(values: List(a), keep: fn(a) -> Bool) -> List(a) {
  values
  |> fold([], fn(acc, x) {
    match keep(x) {
      True -> prepend(acc, x)
      False -> acc
    }
  })
  |> reverse()
}

/// Let each callback either send a transformed value onward or quietly return
/// None.
///
/// ```pooka
/// import pooka/list
///
/// assert list.filter_map([1, 2], fn(x) { Some(x + 1) }) == [2, 3]
/// ```
filter_map(values: List(a), transform: fn(a) -> Option(b)) -> List(b) {
  values
  |> fold([], fn(acc, x) {
    match transform(x) {
      Some(y) -> prepend(acc, y)
      None -> acc
    }
  })
  |> reverse()
}

/// Carry an accumulator through the list. The callback receives accumulator
/// first, element second.
///
/// ```pooka
/// import pooka/list
///
/// assert list.fold([1, 2, 3], 0, fn(acc, x) { acc + x }) == 6
/// ```
fold(values: List(a), initial: b, step: fn(b, a) -> b) -> b {
  match values {
    [] -> initial
    [x, ..rest] -> fold(rest, step(initial, x), step)
  }
}

/// Stop at the first element accepted by the predicate.
///
/// ```pooka
/// import pooka/list
///
/// assert list.find([1, 2, 3], fn(x) { x > 1 }) == Some(2)
/// ```
find(values: List(a), predicate: fn(a) -> Bool) -> Option(a) {
  match values {
    [] -> None
    [x, ..rest] -> match predicate(x) {
      True -> Some(x)
      False -> find(rest, predicate)
    }
  }
}

/// Return True as soon as one element satisfies the predicate.
///
/// ```pooka
/// import pooka/list
///
/// assert list.any([1, 2], fn(x) { x == 2 })
/// ```
any(values: List(a), predicate: fn(a) -> Bool) -> Bool {
  match find(values, predicate) {
    Some(_) -> True
    None -> False
  }
}

/// Require every element to satisfy the predicate. The empty list has no
/// counterexample.
///
/// ```pooka
/// import pooka/list
///
/// assert list.all([], fn(x: Int) { x > 0 })
/// ```
all(values: List(a), predicate: fn(a) -> Bool) -> Bool {
  !any(values, fn(x) { !predicate(x) })
}

/// Test membership with the language's equality operation.
///
/// ```pooka
/// import pooka/list
///
/// assert list.contains([1, 2], 2)
/// ```
contains(values: List(a), value: a) -> Bool {
  any(values, fn(x) { x == value })
}

/// Keep at most count elements. A nonpositive count produces an empty list.
///
/// ```pooka
/// import pooka/list
///
/// assert list.take([1, 2, 3], 2) == [1, 2]
/// ```
take(values: List(a), count: Int) -> List(a) {
  values
  |> _take(count, [])
  |> reverse()
}

/// Carry selected elements in reverse order; the public take reverses them once
/// at the end.
_take(values, count, acc) {
  match count <= 0 {
    True -> acc
    False -> match values {
      [] -> acc
      [x, ..rest] -> _take(rest, count - 1, prepend(acc, x))
    }
  }
}

/// Discard at most count elements. A nonpositive count leaves the list alone.
///
/// ```pooka
/// import pooka/list
///
/// assert list.drop([1, 2, 3], 2) == [3]
/// ```
drop(values: List(a), count: Int) -> List(a) {
  match count <= 0 {
    True -> values
    False -> match values {
      [] -> []
      [_, ..rest] -> drop(rest, count - 1)
    }
  }
}

/// Stable-sort using the Erlang term order exposed by the comparison primitive.
///
/// ```pooka
/// import pooka/list
///
/// assert list.sort([3, 1, 2]) == [1, 2, 3]
/// ```
sort(values: List(a)) -> List(a) {
  _Lists.sort(values)
}

/// Stable-sort using a callback returning Order; equal elements retain their
/// relative order.
///
/// ```pooka
/// import pooka/list
/// import pooka/order.{Order}
///
/// assert list.sort_by([3, 1, 2], fn(a, b) { order.from_int(a - b) }) == [1, 2, 3]
/// ```
sort_by(values: List(a), compare: fn(a, a) -> Order) -> List(a) {
  match values {
    [] -> []
    [_] -> values
    _ -> {
      let middle = _Primitives.quotient(length(values), 2)
      _merge(
        sort_by(take(values, middle), compare),
        sort_by(drop(values, middle), compare),
        compare,
        []
      )
    }
  }
}

/// Merge sorted runs into a reversed accumulator. Equal keys take the left
/// element, preserving sort stability.
_merge(left, right, compare, acc) {
  match #(left, right) {
    #([], _) -> _ListTail.reverse(acc, right)
    #(_, []) -> _ListTail.reverse(acc, left)
    #([x, ..xs], [y, ..ys]) -> match compare(x, y) {
      Order.Greater -> _merge(left, ys, compare, prepend(acc, y))
      _ -> _merge(xs, right, compare, prepend(acc, x))
    }
  }
}

/// Keep the first occurrence of each value. Equality is checked against values
/// already kept.
///
/// ```pooka
/// import pooka/list
///
/// assert list.unique([2, 1, 2, 1]) == [2, 1]
/// ```
unique(values: List(a)) -> List(a) {
  values
  |> fold([], fn(acc, x) {
    match contains(acc, x) {
      True -> acc
      False -> prepend(acc, x)
    }
  })
  |> reverse()
}

/// Count upward from start, stopping before end. Reversed or empty bounds
/// produce an empty list.
///
/// ```pooka
/// import pooka/list
///
/// assert list.range(2, 5) == [2, 3, 4]
/// ```
range(start: Int, end: Int) -> List(Int) {
  _range(start, end, [])
}

/// Count toward the exclusive end with a reversed accumulator, then reverse
/// once.
_range(start, end, acc) {
  match start >= end {
    True -> reverse(acc)
    False -> _range(start + 1, end, prepend(acc, start))
  }
}

/// Let nested lists leave in a single queue, preserving both levels of order.
///
/// ```pooka
/// import pooka/list
/// assert list.flatten([[1], [], [2, 3]]) == [1, 2, 3]
/// ```
flatten(values: List(List(a))) -> List(a) {
  values
  |> fold([], fn(acc, group) {
    fold(group, acc, fn(items, item) { prepend(items, item) })
  })
  |> reverse()
}

/// Visit each item once, then join the returned lists in their original order.
///
/// ```pooka
/// import pooka/list
/// assert list.flat_map([1, 2], fn(n) { [n, n] }) == [1, 1, 2, 2]
/// ```
flat_map(values: List(a), transform: fn(a) -> List(b)) -> List(b) {
  values
  |> fold([], fn(acc, value) {
    fold(transform(value), acc, fn(items, item) { prepend(items, item) })
  })
  |> reverse()
}

/// Pair the visitors while both queues have someone left. Stop at the shorter list.
///
/// ```pooka
/// import pooka/list
/// assert list.zip([1, 2], ["owl"]) == [#(1, "owl")]
/// ```
zip(left: List(a), right: List(b)) -> List(#(a, b)) {
  _zip(left, right, [])
}

// Accumulate backwards so long queues do not leave callers waiting on the stack.
_zip(left, right, acc) {
  match #(left, right) {
    #([x, ..xs], [y, ..ys]) -> _zip(xs, ys, prepend(acc, #(x, y)))
    _ -> reverse(acc)
  }
}

/// Perform an effect for each item from left to right. The empty list returns Nil.
///
/// ```pooka
/// import pooka/list
/// list.each([1, 2], fn(n) { assert n > 0 })
/// ```
each(values: List(a), visit: fn(a) -> Nil) -> Nil {
  loop value in values {
    visit(value)
  }
}

/// Give matching and non-matching values separate seats, preserving both orders.
/// The predicate runs once for every item.
///
/// ```pooka
/// import pooka/list
/// assert list.partition([1, 2, 3], fn(n) { n > 1 }) == #([2, 3], [1])
/// ```
partition(values: List(a), keep: fn(a) -> Bool) -> #(List(a), List(a)) {
  let #(yes, no) = fold(values, #([], []), fn(acc, value) {
    let #(yes, no) = acc
    match keep(value) {
      True -> #(prepend(yes, value), no)
      False -> #(yes, prepend(no, value))
    }
  })
  #(reverse(yes), reverse(no))
}

/// Split before the zero-based position. Non-positive counts keep the whole
/// list on the right; oversized counts leave an empty right side.
///
/// ```pooka
/// import pooka/list
/// assert list.split([1, 2, 3], 2) == #([1, 2], [3])
/// ```
split(values: List(a), count: Int) -> #(List(a), List(a)) {
  _split(values, count, [])
}

// Keep the original suffix rather than walking it again.
_split(values, count, acc) {
  match count <= 0 {
    True -> #(reverse(acc), values)
    False -> match values {
      [] -> #(reverse(acc), [])
      [head, ..tail] -> _split(tail, count - 1, prepend(acc, head))
    }
  }
}

/// Keep the longest matching prefix. Stop asking the predicate at the first
/// False; the remaining suffix is returned unchanged.
///
/// ```pooka
/// import pooka/list
/// assert list.split_while([1, 2, 0, 3], fn(n) { n > 0 }) == #([1, 2], [0, 3])
/// ```
split_while(values: List(a), keep: fn(a) -> Bool) -> #(List(a), List(a)) {
  _split_while(values, keep, [])
}

_split_while(values, keep, acc) {
  match values {
    [] -> #(reverse(acc), [])
    [head, ..tail] -> match keep(head) {
      True -> _split_while(tail, keep, prepend(acc, head))
      False -> #(reverse(acc), values)
    }
  }
}

/// Return the first Some produced by the callback. Later items are not visited.
///
/// ```pooka
/// import pooka/list
/// assert list.find_map([1, 2], fn(n) { match n { 2 -> Some("owl") _ -> None } }) == Some("owl")
/// ```
find_map(values: List(a), find: fn(a) -> Option(b)) -> Option(b) {
  match values {
    [] -> None
    [head, ..tail] -> match find(head) {
      Some(value) -> Some(value)
      None -> find_map(tail, find)
    }
  }
}

/// Count the matching items, asking the predicate once for each one.
///
/// ```pooka
/// import pooka/list
/// assert list.count([1, 2, 3], fn(n) { n > 1 }) == 2
/// ```
count(values: List(a), keep: fn(a) -> Bool) -> Int {
  fold(values, 0, fn(total, value) {
    match keep(value) {
      True -> total + 1
      False -> total
    }
  })
}

/// Make a list containing count copies of value. Non-positive counts return [].
///
/// ```pooka
/// import pooka/list
/// assert list.repeat("owl", 2) == ["owl", "owl"]
/// ```
repeat(value: a, count: Int) -> List(a) {
  _repeat(value, count, [])
}

_repeat(value, count, acc) {
  match count <= 0 {
    True -> acc
    False -> _repeat(value, count - 1, prepend(acc, value))
  }
}

/// Map from left to right with a zero-based index. The callback receives the
/// value first and its index second.
///
/// ```pooka
/// import pooka/list
/// assert list.index_map([10, 20], fn(n, index) { n + index }) == [10, 21]
/// ```
index_map(values: List(a), transform: fn(a, Int) -> b) -> List(b) {
  _index_map(values, transform, 0, [])
}

_index_map(values, transform, index, acc) {
  match values {
    [] -> reverse(acc)
    [head, ..tail] -> _index_map(
      tail,
      transform,
      index + 1,
      prepend(acc, transform(head, index))
    )
  }
}

/// Fold with the accumulator, value and zero-based index, in that order.
///
/// ```pooka
/// import pooka/list
/// assert list.index_fold([10, 20], 0, fn(acc, n, index) { acc + n + index }) == 31
/// ```
index_fold(values: List(a), initial: b, step: fn(b, a, Int) -> b) -> b {
  _index_fold(values, initial, step, 0)
}

_index_fold(values, acc, step, index) {
  match values {
    [] -> acc
    [head, ..tail] -> _index_fold(tail, step(acc, head, index), step, index + 1)
  }
}

/// Look up the first pair with this key. Missing keys return None.
///
/// ```pooka
/// import pooka/list
/// assert list.key_find([#("owl", 2), #("owl", 3)], "owl") == Some(2)
/// ```
key_find(pairs: List(#(k, v)), key: k) -> Option(v) {
  match pairs {
    [] -> None
    [pair, ..tail] -> {
      let #(candidate, value) = pair
      match candidate == key {
        True -> Some(value)
        False -> key_find(tail, key)
      }
    }
  }
}

/// Map fallible work in order. The first Error returns immediately; remaining
/// callbacks are not called. An empty list succeeds with Ok([]).
///
/// ```pooka
/// import pooka/list
/// assert list.try_map([1, 2], fn(n) { Ok(n + 1) }) == Ok([2, 3])
/// ```
try_map(values: List(a), transform: fn(a) -> Result(b, e)) -> Result(List(b), e) {
  _try_map(values, transform, [])
}

_try_map(values: List(a), transform: fn(a) -> Result(b, e), acc: List(b)) -> Result(
  List(b),
  e
) {
  match values {
    [] -> Ok(reverse(acc))
    [head, ..tail] -> {
      let value = transform(head)?
      _try_map(tail, transform, prepend(acc, value))
    }
  }
}

/// Carry a fallible accumulator from left to right. The first Error stops the
/// walk; an empty list returns Ok(initial).
///
/// ```pooka
/// import pooka/list
/// assert list.try_fold([1, 2], 0, fn(acc, n) { Ok(acc + n) }) == Ok(3)
/// ```
try_fold(values: List(a), initial: b, step: fn(b, a) -> Result(b, e)) -> Result(
  b,
  e
) {
  match values {
    [] -> Ok(initial)
    [head, ..tail] -> {
      let next = step(initial, head)?
      try_fold(tail, next, step)
    }
  }
}

/// Perform fallible effects in order. Stop at the first Error; the empty list
/// succeeds with Ok(Nil).
///
/// ```pooka
/// import pooka/list
/// assert list.try_each([1, 2], fn(n) { assert n > 0
///   Ok(Nil) }) == Ok(Nil)
/// ```
try_each(values: List(a), visit: fn(a) -> Result(Nil, e)) -> Result(Nil, e) {
  match values {
    [] -> Ok(Nil)
    [head, ..tail] -> {
      let _ = visit(head)?
      try_each(tail, visit)
    }
  }
}
