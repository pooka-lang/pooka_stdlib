//// Keep the pieces until somebody asks for the whole parcel.
//// Appending makes a branch in constant time. Rendering walks an explicit work
//// list, preserving chunk order without recursive calls down a deep left spine.
//// Text stays UTF-8; byte counts describe encoding, not visible characters.
////
//// ```pooka
//// assert string_tree.to_string(string_tree.from_string("oak")) == "oak"
//// ```

module string_tree

import pooka/list
import pooka/string

/// An immutable tree. Only the private leaf and branch classes construct its values.
class StringTree {}

class _Empty is StringTree {}

class _Leaf(value: String) is StringTree

class _Branch(left: StringTree, right: StringTree) is StringTree

/// Start without any chunks.
new() -> StringTree {
  _Empty()
}

/// Keep a chunk without copying its contents.
from_string(value: String) -> StringTree {
  _Leaf(value)
}

/// Attach one chunk in constant time.
///
/// ```pooka
/// assert string_tree.to_string(string_tree.append(string_tree.new(), "oak")) == "oak"
/// ```
append(tree: StringTree, value: String) -> StringTree {
  append_tree(tree, from_string(value))
}

/// Attach another tree without walking either side.
append_tree(left: StringTree, right: StringTree) -> StringTree {
  _Branch(left, right)
}

/// Place one chunk before the earlier tree.
prepend(tree: StringTree, value: String) -> StringTree {
  append_tree(from_string(value), tree)
}

/// Join trees in input order without rendering their chunks.
concat(trees: List(StringTree)) -> StringTree {
  list.fold(trees, new(), append_tree)
}

/// Keep each supplied chunk as a leaf.
from_strings(values: List(String)) -> StringTree {
  list.fold(values, new(), append)
}

/// Render once, preserving every chunk's order.
to_string(tree: StringTree) -> String {
  string.join(_chunks([tree], []), "")
}

/// Count encoded bytes without joining the chunks.
byte_size(tree: StringTree) -> Int {
  list.fold(_chunks([tree], []), 0, fn(acc, value) {
    acc + string.byte_size(value)
  })
}

/// Ask whether rendering would produce an empty value.
is_empty(tree: StringTree) -> Bool {
  byte_size(tree) == 0
}

_chunks(pending: List(StringTree), acc: List(String)) -> List(String) {
  match pending {
    [] -> list.reverse(acc)
    [_Leaf(value), ..rest] -> _chunks(rest, [value, ..acc])
    [_Branch(left, right), ..rest] -> _chunks([left, right, ..rest], acc)
    [_Empty(), ..rest] -> _chunks(rest, acc)
  }
}
