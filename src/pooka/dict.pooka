//// Keep the keys in a small cabinet whose earlier drawers remain intact.
////
//// A Dict holds one immutable Erlang map. Updates return a new dictionary
//// without changing the earlier one. Iteration order is unspecified, and
//// duplicate input keys keep their last value.
////
//// ```pooka
//// import pooka/dict
////
//// assert dict.from_list([#("oak", 3)]).get("oak") == Some(3)
//// ```

module dict

import pooka/internal/traversal as list

/// Only the foreign functions supply values of this type. The phantom type
/// parameters keep keys and values bound to the same map across each call.
class _Map(k, v) {}

external _Storage from erlang "pooka_stdlib_ffi" {
  dict_new() -> _Map(k, v)

  dict_get(storage: _Map(k, v), key: k) -> Option(v)
}

external _Maps from erlang "maps" {
  put(key: k, value: v, storage: _Map(k, v)) -> _Map(k, v)

  remove(key: k, storage: _Map(k, v)) -> _Map(k, v)

  from_list(pairs: List(#(k, v))) -> _Map(k, v)

  to_list(storage: _Map(k, v)) -> List(#(k, v))
}

external _Erlang from erlang "erlang" {
  map_size(storage: _Map(k, v)) -> Int
}

/// An immutable key/value cabinet backed by a typed native map.
/// Prefer empty and from_list when constructing public dictionaries.
class Dict(k, v) {
  let _storage: _Map(k, v)

  /// Create the value from its declared fields. Public factory functions keep
  /// the storage details out of ordinary calling code.
  new(storage: _Map(k, v)) {
    self._storage = storage
  }

  /// Look up one key without treating absence as an exception.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.from_list([#("oak", 1)]).get("oak") == Some(1)
  /// ```
  get(key: k) -> Option(v) {
    _Storage.dict_get(_storage, key)
  }

  /// Return a dictionary with the key associated to the new value.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.empty().insert("oak", 2).get("oak") == Some(2)
  /// ```
  insert(key: k, value: v) -> Dict(k, v) {
    Dict(_Maps.put(key, value, _storage))
  }

  /// Return a dictionary without the key. Removing an absent key is harmless.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.from_list([#("oak", 1)]).delete("oak").is_empty()
  /// ```
  delete(key: k) -> Dict(k, v) {
    Dict(_Maps.remove(key, _storage))
  }

  /// Read a key or return the supplied fallback. An existing value is kept.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.empty().get_or("owl", 0) == 0
  /// ```
  get_or(key: k, fallback: v) -> v {
    match _Storage.dict_get(_storage, key) {
      Some(value) -> value
      None -> fallback
    }
  }

  /// Let the callback see the previous value, or None for a new key. Store its
  /// result in a new dictionary, leaving the earlier dictionary untouched.
  /// The callback is called once, whether or not the key already exists.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.empty().upsert("owl", fn(_) { 1 }).get("owl") == Some(1)
  /// ```
  upsert(key: k, change: fn(Option(v)) -> v) -> Dict(k, v) {
    insert(key, change(_Storage.dict_get(_storage, key)))
  }

  /// Check membership without exposing the stored value.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.from_list([#("oak", 1)]).has_key("oak")
  /// ```
  has_key(key: k) -> Bool {
    match _Storage.dict_get(_storage, key) {
      Some(_) -> True
      None -> False
    }
  }

  /// Count distinct keys.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.from_list([#("oak", 1)]).size() == 1
  /// ```
  size() -> Int {
    _Erlang.map_size(_storage)
  }

  /// Ask whether no keys are stored.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.empty().is_empty()
  /// ```
  is_empty() -> Bool {
    _Erlang.map_size(_storage) == 0
  }

  /// Enumerate keys in unspecified order.
  ///
  /// ```pooka
  /// import pooka/dict
  /// import pooka/internal/traversal as list
  ///
  /// assert list.contains(dict.from_list([#("oak", 1)]).keys(), "oak")
  /// ```
  keys() -> List(k) {
    list.map(_Maps.to_list(_storage), fn(pair) {
      let #(key, _) = pair
      key
    })
  }

  /// Enumerate stored values in unspecified order.
  ///
  /// ```pooka
  /// import pooka/dict
  /// import pooka/internal/traversal as list
  ///
  /// assert list.contains(dict.from_list([#("oak", 1)]).values(), 1)
  /// ```
  values() -> List(v) {
    list.map(_Maps.to_list(_storage), fn(pair) {
      let #(_, value) = pair
      value
    })
  }

  /// Enumerate key/value pairs in unspecified order.
  ///
  /// ```pooka
  /// import pooka/dict
  /// import pooka/internal/traversal as list
  ///
  /// assert list.contains(dict.from_list([#("oak", 1)]).to_list(), #("oak", 1))
  /// ```
  to_list() -> List(#(k, v)) {
    _Maps.to_list(_storage)
  }

  /// Transform each value while retaining keys. The value type may change.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.from_list([#("oak", 1)]).map_values(fn(x) { x == 1 }).get("oak") == Some(True)
  /// ```
  map_values(transform: fn(v) -> b) -> Dict(k, b) {
    _Maps.to_list(_storage)
    |> list.map(fn(pair) {
      let #(key, value) = pair
      #(key, transform(value))
    })
    |> from_list()
  }

  /// Keep pairs whose key-and-value predicate returns True.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.from_list([#("oak", 1)]).filter(fn(_, value) { value > 1 }).is_empty()
  /// ```
  filter(keep: fn(k, v) -> Bool) -> Dict(k, v) {
    _Maps.to_list(_storage)
    |> list.filter(fn(pair) {
      let #(key, value) = pair
      keep(key, value)
    })
    |> from_list()
  }

  /// Fold with accumulator, key and value. Entry order is unspecified.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.from_list([#("oak", 2)]).fold(0, fn(acc, _, value) { acc + value }) == 2
  /// ```
  fold(initial: b, step: fn(b, k, v) -> b) -> b {
    list.fold(_Maps.to_list(_storage), initial, fn(acc, pair) {
      let #(key, value) = pair
      step(acc, key, value)
    })
  }

  /// Compare keys and values regardless of insertion order.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.from_list([#("oak", 1)]).equals(dict.from_list([#("oak", 1)]))
  /// ```
  equals(right: Dict(k, v)) -> Bool {
    _storage == right._storage
  }

  /// Merge dictionaries, taking the right-hand value for a shared key.
  ///
  /// ```pooka
  /// import pooka/dict
  ///
  /// assert dict.from_list([#("oak", 1)]).merge(dict.from_list([#("oak", 2)])).get("oak") == Some(2)
  /// ```
  merge(right: Dict(k, v)) -> Dict(k, v) {
    _Maps.to_list(_storage)
    |> list.concat(right.to_list())
    |> from_list()
  }

  /// Merge both cabinets, asking the callback only for shared keys.
  ///
  /// ```pooka
  /// assert dict.from_list([#("a", 1)]).combine(dict.from_list([#("a", 2)]), fn(_, a, b) { a + b }).get("a") == Some(3)
  /// ```
  combine(right: Dict(k, v), resolve: fn(k, v, v) -> v) -> Dict(k, v) {
    list.fold(right.to_list(), Dict(_storage), fn(acc, pair) {
      let #(key, value) = pair
      acc.insert(key, match get(key) {
        None -> value
        Some(left) -> resolve(key, left, value)
      })
    })
  }

  /// Keep only requested keys; missing and repeated keys are harmless.
  ///
  /// ```pooka
  /// assert dict.from_list([#("a", 1)]).take(["a", "missing"]).size() == 1
  /// ```
  take(keys: List(k)) -> Dict(k, v) {
    list.fold(keys, empty(), fn(acc, key) {
      match get(key) {
        None -> acc
        Some(value) -> acc.insert(key, value)
      }
    })
  }

  /// Remove requested keys, leaving the original dictionary intact.
  ///
  /// ```pooka
  /// assert dict.from_list([#("a", 1)]).drop(["a"]).is_empty()
  /// ```
  drop(keys: List(k)) -> Dict(k, v) {
    list.fold(keys, Dict(_storage), fn(acc, key) { acc.delete(key) })
  }

  /// Visit every pair once. Dictionary iteration order is unspecified.
  ///
  /// ```pooka
  /// dict.from_list([#("a", 1)]).each(fn(_, value) { assert value == 1 })
  /// ```
  each(visit: fn(k, v) -> Nil) -> Nil {
    list.each(to_list(), fn(pair) {
      let #(key, value) = pair
      visit(key, value)
    })
  }
}

/// Open an empty typed dictionary.
///
/// ```pooka
/// import pooka/dict
///
/// assert dict.empty().is_empty()
/// ```
empty() -> Dict(k, v) {
  Dict(_Storage.dict_new())
}

/// Build a dictionary from pairs. For repeated keys, the last pair wins.
///
/// ```pooka
/// import pooka/dict
///
/// assert dict.from_list([#("oak", 1), #("oak", 2)]).get("oak") == Some(2)
/// ```
from_list(pairs: List(#(k, v))) -> Dict(k, v) {
  Dict(_Maps.from_list(pairs))
}
